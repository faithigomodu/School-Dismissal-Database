 --CREATE TABLE |  IDA B WELLS Database Part 1 
-----------------------------------------------------------------------------------

-- Creates the ADULT entity 
CREATE TABLE ADULT (

     --Attributes definition 	
     adult_id     NUMBER(9) PRIMARY KEY, 
     first_name   VARCHAR2 (120)  NOT NULL, 
     last_name    VARCHAR2 (120) NOT NULL, 
     phone_number VARCHAR2 (60) UNIQUE, 
     address      VARCHAR2 (120)
	
     );

-- Creates the STUDENT entity 
CREATE TABLE STUDENT (

     --Attributes definition 	
     student_id     NUMBER(9) PRIMARY KEY, 
     first_name   VARCHAR2 (120)  NOT NULL, 
     last_name    VARCHAR2 (120) NOT NULL, 
     phone_number VARCHAR2 (60) UNIQUE, 
     address      VARCHAR2 (120)
	
     );	 

-- Creates the ACTIVITY entity 
CREATE TABLE ACTIVITY (

     --Attributes definition 	
     activity_id     NUMBER(9) PRIMARY KEY, 
     activity_name   VARCHAR2 (120)  NOT NULL 
     	
     );	

-- Creates the ORGANIZATION entity 
CREATE TABLE ORGANIZATION (

     --Attributes definition 	
     organization_id     NUMBER(9) PRIMARY KEY, 
     name            VARCHAR2(120) NOT NULL,
     description     VARCHAR2(120),
     address         VARCHAR2(120),
     phone_number    VARCHAR2(120) UNIQUE    
     	
     );	

-- Creates the SCHOOL_BUS entity 
CREATE TABLE SCHOOL_BUS (

     --Attributes definition 	
     bus_id     NUMBER(9) PRIMARY KEY, 
     weekday_schedule   VARCHAR2 (120)  NOT NULL 
     	
     );	

--Creates the ADULT_STUDENT junction table 
CREATE TABLE ADULT_STUDENT (

     --Attributes definition 
     adult_id	  NUMBER(9),
     student_id   NUMBER(9),
     relationship VARCHAR2 (120)  NOT NULL, --aunt, father, mother, grandmother, grandfather, uncle, legal guardian, 						babysitter, brother, sister
     
     --Primary key definition 
     CONSTRAINT pk_adult_student PRIMARY KEY (adult_id, student_id),
     
     --Adult foreign key definition 
     CONSTRAINT fk_as_adult
         FOREIGN KEY (adult_id)
	 REFERENCES ADULT(adult_id), 

      --Student foreign key definition 
     CONSTRAINT fk_as_student
         FOREIGN KEY (student_id)
	 REFERENCES STUDENT(student_id)      

  );


  
--Creates the STUDENT_ACTIVITY junction table 
CREATE TABLE STUDENT_ACTIVITY (

     --Attributes definition 
     activity_id  NUMBER(9),
     student_id   NUMBER(9),
     time         TIMESTAMP,
     weekday      DATE,
     
     
     --Primary key definition 
     CONSTRAINT pk_student_activity PRIMARY KEY (activity_id, student_id),
     
     --Student foreign key definition 
     CONSTRAINT fk_sa_student
         FOREIGN KEY (student_id)
	 REFERENCES STUDENT (student_id), 

      --Activity foreign key definition 
     CONSTRAINT fk_sa_activity
         FOREIGN KEY (activity_id)
	 REFERENCES ACTIVITY(activity_id)      

  );


--Creates the PICKUP_AUTHORIZATION junction table 
CREATE TABLE PICKUP_AUTHORIZATION  (

     --Attributes definition 
     pickup_authorization_id  NUMBER(9) PRIMARY KEY,
     pickup_date  DATE,
     pickup_time  TIMESTAMP,
     picked_up_by VARCHAR2(100) NOT NULL, 
     authorized_status VARCHAR2(100) CHECK(authorized_status IN ('approved', 'denied')), 
     student_id  NUMBER(9),
     adult_id    NUMBER(9),
     bus_id      NUMBER(9),
     organization_id  NUMBER(9),

     
     
      --Student foreign key definition 
     CONSTRAINT fk_pua_student
         FOREIGN KEY (student_id)
	 REFERENCES STUDENT (student_id), 

      --Adult foreign key definition 
     CONSTRAINT fk_pua_adult
         FOREIGN KEY (adult_id)
	 REFERENCES ADULT (adult_id),  

      --Organization foreign key definition 
     CONSTRAINT fk_pua_organization
         FOREIGN KEY (organization_id)
	 REFERENCES ORGANIZATION (organization_id), 

      --School bus foreign key definition 
     CONSTRAINT fk_pua_bus
         FOREIGN KEY (bus_id)
	 REFERENCES SCHOOL_BUS(bus_id)    

  ); 

